<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".ui.SettingsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Brightness Control Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/brightness_control"
            android:textAppearance="?attr/textAppearanceHeadline5"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <SeekBar
                android:id="@+id/brightness_slider"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:layout_gravity="center_vertical" />

            <TextView
                android:id="@+id/brightness_value"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="128"
                android:textAppearance="?attr/textAppearanceHeadline6" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="#CCCCCC" />

        <!-- WiFi Connection Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="WiFi Connection"
            android:textAppearance="?attr/textAppearanceHeadline5"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tv_wifi_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Connected to: Not connected"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:layout_marginBottom="12dp"
            android:padding="8dp"
            android:background="#F5F5F5" />

        <Button
            android:id="@+id/btn_scan_wifi"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Scan WiFi Networks"
            android:layout_marginBottom="12dp" />

        <Spinner
            android:id="@+id/spinner_wifi_networks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="WiFi Password (optional)"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/et_wifi_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Leave empty for open networks"
            android:inputType="textPassword"
            android:layout_marginBottom="12dp"
            android:padding="12dp"
            android:background="@android:drawable/edit_text" />

        <Button
            android:id="@+id/btn_connect_led_control"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Connect to LED_control"
            android:layout_marginBottom="12dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="#CCCCCC" />

        <!-- Device Connection Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/device_connection"
            android:textAppearance="?attr/textAppearanceHeadline5"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/device_ip_label"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/et_device_ip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/device_ip_hint"
            android:inputType="text"
            android:text="192.168.4.1:443"
            android:layout_marginBottom="12dp"
            android:padding="12dp"
            android:background="@android:drawable/edit_text" />

        <Button
            android:id="@+id/btn_update_ip"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/update_ip"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btn_refresh_state"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/refresh_device_state" />

    </LinearLayout>

    </ScrollView>

</layout>
